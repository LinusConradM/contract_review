# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Database (Prisma) ---
# Local dev: a local Postgres. Production: your hosted DB (Neon/Supabase/etc.)
DATABASE_URL="postgresql://USER@localhost:5432/contract_review"

# --- Trigger.dev ---
# Use the tr_dev_... key locally, the tr_prod_... key in production.
TRIGGER_SECRET_KEY="tr_dev_xxx"

# --- App ---
# Public base URL, used to build links in emails. Set to your real domain in prod.
APP_URL="http://localhost:3000"

# --- LLM providers (at least one required) ---
# Canonical fallback order: groq -> gemini -> openrouter -> openai -> anthropic.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional: pin a preferred provider / models.
LLM_PROVIDER=""
GROQ_MODEL=""

# --- Email (Resend) ---
# Without a key, emails are logged instead of sent (fine for local/demo).
# For real delivery, verify a domain in Resend and set RESEND_FROM to it.
RESEND_API_KEY=""
RESEND_FROM=""

# --- File storage (S3-compatible object storage) ---
# Leave S3_BUCKET unset to use the local filesystem (single-machine dev only).
# Set these to use object storage (REQUIRED for production, since the web app
# and Trigger.dev workers run on separate machines with no shared disk).
#
# Cloudflare R2 example:
#   S3_BUCKET=contract-review
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# AWS S3 example:
#   S3_BUCKET=contract-review
#   S3_ENDPOINT=                      (leave empty for AWS)
#   S3_REGION=us-east-1
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Misc ---
# Override the 7-day review reminder delay for testing (in seconds).
REVIEW_REMINDER_DELAY_SECONDS=""
